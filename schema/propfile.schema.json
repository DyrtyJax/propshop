{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DyrtyJax/propshop/main/schema/propfile.schema.json",
  "title": "PropShop Propfile",
  "description": "A reproducible creative asset build manifest.",
  "type": "object",
  "required": ["version", "project", "providers", "props"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "outputDir": { "type": "string", "default": "props" },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "references": { "type": "array", "items": { "type": "string" }, "default": [] },
        "palette": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["adapter"],
        "additionalProperties": false,
        "properties": {
          "adapter": { "type": "string", "minLength": 1 },
          "env": { "type": "string", "minLength": 1 },
          "options": { "type": "object" }
        }
      }
    },
    "props": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "prompt", "provider"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "kind": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "variants": { "type": "integer", "minimum": 1, "maximum": 16, "default": 1 },
          "input": { "type": "object", "default": {} },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "extension": { "type": "string" },
              "mediaType": { "type": "string" }
            }
          },
          "tags": { "type": "array", "items": { "type": "string" }, "default": [] }
        }
      }
    }
  }
}

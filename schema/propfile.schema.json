{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DyrtyJax/propshop/main/schema/propfile.schema.json",
  "title": "PropShop Propfile",
  "description": "A reproducible creative asset build manifest.",
  "type": "object",
  "required": ["version", "project", "providers", "props"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "outputDir": { "type": "string", "default": "props" },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "references": { "type": "array", "items": { "type": "string" }, "default": [] },
        "palette": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["adapter"],
        "additionalProperties": false,
        "properties": {
          "adapter": { "type": "string", "minLength": 1 },
          "env": { "type": "string", "minLength": 1 },
          "options": { "type": "object" }
        }
      }
    },
    "props": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "prompt", "provider"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "kind": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "prompt": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "variants": { "type": "integer", "minimum": 1, "maximum": 16, "default": 1 },
          "input": { "type": "object", "default": {} },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "extension": { "type": "string" },
              "mediaType": { "type": "string" }
            }
          },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "audio": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "durationSeconds": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "min": { "type": "number", "minimum": 0 },
                      "max": { "type": "number", "exclusiveMinimum": 0 }
                    }
                  },
                  "sampleRates": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
                  "channels": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
                  "minRmsDbfs": { "type": "number", "maximum": 0 },
                  "maxPeakDbfs": { "type": "number", "maximum": 0 },
                  "maxClippedRatio": { "type": "number", "minimum": 0, "maximum": 1 },
                  "maxLeadingSilenceSeconds": { "type": "number", "minimum": 0 },
                  "maxTrailingSilenceSeconds": { "type": "number", "minimum": 0 }
                }
              }
            }
          },
          "tags": { "type": "array", "items": { "type": "string" }, "default": [] }
        }
      }
    }
  }
}

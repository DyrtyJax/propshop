{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://propshop.dev/schema/music-video-explainer/shot-manifest.schema.json",
  "title": "PropShop music-video shot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "render", "audio", "performer", "style", "budget", "shots"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "durationSeconds"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["master", "vocals"],
      "properties": {
        "master": { "type": "string", "minLength": 1 },
        "vocals": { "type": "string", "minLength": 1 },
        "masterSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "performer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceImage", "canonicalPrompt", "provider", "model", "mode"],
      "properties": {
        "referenceImage": { "type": "string", "minLength": 1 },
        "canonicalPrompt": { "type": "string", "minLength": 1 },
        "provider": { "const": "replicate" },
        "model": { "const": "kwaivgi/kling-avatar-v2" },
        "mode": { "enum": ["std", "pro"] }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["palette", "typefaces", "texture"],
      "properties": {
        "palette": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^#[A-Fa-f0-9]{6}$" } },
        "typefaces": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "texture": { "type": "string", "minLength": 1 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "maximum", "takesPerPerformanceShot"],
      "properties": {
        "currency": { "const": "USD" },
        "maximum": { "type": "number", "minimum": 0 },
        "takesPerPerformanceShot": { "type": "integer", "minimum": 1 }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "startSeconds", "endSeconds", "purpose", "onScreenText", "factIds", "assets"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "kind": { "enum": ["performance", "map", "metric", "title"] },
          "startSeconds": { "type": "number", "minimum": 0 },
          "endSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "purpose": { "type": "string", "minLength": 1 },
          "onScreenText": { "type": "array", "items": { "type": "string" } },
          "factIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "assets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "performanceDirection": { "type": "string", "minLength": 1 },
          "vocal": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startSeconds", "endSeconds"],
            "properties": {
              "startSeconds": { "type": "number", "minimum": 0 },
              "endSeconds": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  }
}

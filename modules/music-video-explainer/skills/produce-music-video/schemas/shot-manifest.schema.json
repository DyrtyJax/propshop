{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://propshop.dev/schema/music-video-explainer/shot-manifest.schema.json",
  "title": "Optional PropShop music-video shot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "render", "budget", "shots"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "project": { "type": "string", "minLength": 1 },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "durationSeconds"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["master"],
      "properties": {
        "master": { "type": "string", "minLength": 1 },
        "vocals": { "type": "string", "minLength": 1 },
        "masterSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "performer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "referenceImage": { "type": "string", "minLength": 1 },
        "canonicalPrompt": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^#[A-Fa-f0-9]{6}$" } },
        "typefaces": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "texture": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "maximum"],
      "properties": {
        "currency": { "type": "string", "minLength": 3 },
        "maximum": { "type": "number", "minimum": 0 },
        "spent": { "type": "number", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "startSeconds", "endSeconds", "purpose"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "kind": { "enum": ["performance", "narrative", "map", "metric", "title", "transition", "other"] },
          "startSeconds": { "type": "number", "minimum": 0 },
          "endSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "purpose": { "type": "string", "minLength": 1 },
          "onScreenText": { "type": "array", "items": { "type": "string" } },
          "factIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "assets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "performanceDirection": { "type": "string", "minLength": 1 },
          "vocal": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startSeconds", "endSeconds"],
            "properties": {
              "startSeconds": { "type": "number", "minimum": 0 },
              "endSeconds": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}

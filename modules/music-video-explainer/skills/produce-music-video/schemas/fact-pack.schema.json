{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://propshop.dev/schema/music-video-explainer/fact-pack.schema.json",
  "title": "PropShop music-video fact pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "asOf", "sources", "claims"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "asOf": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "publisher", "url", "accessedAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "accessedAt": { "type": "string", "format": "date" },
          "notes": { "type": "string" }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "status", "sourceIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "text": { "type": "string", "minLength": 1 },
          "status": { "enum": ["draft", "verified"] },
          "sourceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
